rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return (!('name' in data) || (data.name is string && data.name.size() <= 120)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
             (!('dailyGoal' in data) || (data.dailyGoal is number && data.dailyGoal >= 0 && data.dailyGoal <= 1000000)) &&
             (!('weeklyGoal' in data) || (data.weeklyGoal is number && data.weeklyGoal >= 0 && data.weeklyGoal <= 1000000)) &&
             (!('monthlyGoal' in data) || (data.monthlyGoal is number && data.monthlyGoal >= 0 && data.monthlyGoal <= 10000000));
    }

    function isValidSession(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() < 120 &&
             data.date is string && data.date.size() <= 30 &&
             data.durationMinutes is number && data.durationMinutes >= 0 && data.durationMinutes <= 100000 &&
             data.distanceKm is number && data.distanceKm >= 0 && data.distanceKm <= 100000 &&
             data.income is number && data.income >= 0 && data.income <= 1000000;
    }

    function isValidExpense(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() < 120 &&
             data.date is string && data.date.size() <= 30 &&
             data.category is string && data.category.size() <= 80 &&
             data.amount is number && data.amount >= 0 && data.amount <= 1000000;
    }

    function isValidFuelEntry(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() < 120 &&
             data.date is string && data.date.size() <= 30 &&
             data.liters is number && data.liters >= 0 && data.liters <= 10000 &&
             data.totalCost is number && data.totalCost >= 0 && data.totalCost <= 1000000;
    }

    function isValidRide(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() < 120 &&
             data.platform is string && data.platform.size() <= 60 &&
             (
               ('offeredValue' in data && data.offeredValue is number && data.offeredValue >= 0) ||
               ('grossValue' in data && data.grossValue is number && data.grossValue >= 0)
             );
    }

    // ===============================================================
    // User Rules & Subcollections
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId);

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidSession(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /expenses/{expenseId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidExpense(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /fuelEntries/{entryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidFuelEntry(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /rides/{rideId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidRide(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }
  }
}
